<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.docflow</groupId>
	<artifactId>docflow-backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name/>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
		<!-- Day 25：Spring AI 版本。官方支持矩阵：2.0.x 对应 Spring Boot 4.0.x / 4.1.x。 -->
		<spring-ai.version>2.0.2</spring-ai.version>
		<!-- Day 29：surefire 默认排除的测试分组（@Tag）。
		     默认 integration：普通 mvn test 只跑单元测试，不依赖外部 Qdrant/MySQL/百炼；
		     跑集成测试时用 -Dsurefire.excludedGroups= 覆盖成空值（放行 integration 标签），
		     不必再临时改 pom。属性化是为了让命令行能覆盖——硬编码的插件配置
		     Maven 不允许 -D 覆盖，这是从 Day 28 核验时踩出来的坑。 -->
		<surefire.excludedGroups>integration</surefire.excludedGroups>
	</properties>
	<dependencyManagement>
		<dependencies>
			<!-- Day 25：Spring AI BOM——统一声明所有 spring-ai-* 模块的版本，
			     所以下方 starter 不用写版本号。BOM 已发布到 Maven Central，无需加仓库。 -->
			<dependency>
				<groupId>org.springframework.ai</groupId>
				<artifactId>spring-ai-bom</artifactId>
				<version>${spring-ai.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter</artifactId>
		</dependency>
		<dependency>
			<groupId>org.mybatis.spring.boot</groupId>
			<artifactId>mybatis-spring-boot-starter</artifactId>
			<version>4.1.0</version>
		</dependency>

	<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jdbc</artifactId>
		</dependency>
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>

	<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
	<dependency>
		<groupId>org.apache.pdfbox</groupId>
		<artifactId>pdfbox</artifactId>
		<version>3.0.8</version>
	</dependency>
	<!-- Day 21：Apache POI，解析 DOCX（Office Open XML = ZIP + XML）。
	     poi-ooxml 是处理 .docx/.xlsx/.pptx 这代格式的模块，会传递带入
	     poi 核心、xmlbeans、commons-compress 等依赖，无需逐个声明。
	     6.0.0 要求 Java 17+（本项目 Java 21），其内部 PDFBox 版本与本项目
	     现有 3.0.8 一致，无版本冲突。 -->
	<dependency>
		<groupId>org.apache.poi</groupId>
		<artifactId>poi-ooxml</artifactId>
		<version>6.0.0</version>
	</dependency>
	<!-- Day 25：Spring AI 的 OpenAI 模型模块。百炼提供 OpenAI 兼容接口，
	     所以用 OpenAI 集成、把 base-url 指向百炼即可，不需要百炼专属 SDK。
	     starter 会自动配置 EmbeddingModel（HTTP 客户端、重试、鉴权都由它管）。 -->
	<dependency>
		<groupId>org.springframework.ai</groupId>
		<artifactId>spring-ai-starter-model-openai</artifactId>
	</dependency>
	<!-- Day 28：Qdrant 官方 Java 客户端（gRPC 协议，走 6334 端口）。
	     为什么不用 spring-ai-starter-vector-store-qdrant（Spring AI 的 VectorStore 抽象）：
	     本项目需要把 MySQL chunk 主键直接指定为 Qdrant Point ID、精确控制
	     payload 字段（documentId/chunkId/chunkIndex 三个就够）、以及 upsert 幂等
	     ——这些 Point 层的细节在 VectorStore 抽象里是藏起来的，且它 add() 时会
	     自己再调一次 EmbeddingModel，与已有的 EmbeddingService 路径重复。
	     官方客户端独立演进（1.20.0，2026-10 发布），不依赖 Spring 版本，
	     与 Spring Boot 4.1.1 无兼容性问题。 -->
	<dependency>
		<groupId>io.qdrant</groupId>
		<artifactId>client</artifactId>
		<version>1.20.0</version>
	</dependency>
	<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<!-- Day 28/29：把"真实 Qdrant/MySQL/百炼 集成测试"与普通单元测试分开。
			     集成测试标了 @Tag("integration")，默认（见 properties.surefire.excludedGroups）
			     mvn test 排除它——普通单元测试不依赖外部服务，任何时候都能跑。

			     触发集成测试的两种方式（需先启动本地 Qdrant）：
			     - IDE：直接 Run 测试类（IDE 绕过 surefire 的 excludedGroups，天然放行）；
			     - CLI：mvn test -Dtest=XxxIntegrationTest -DfailIfNoTests=false
			               -Dsurefire.excludedGroups=
			       （空值覆盖 properties 默认的 integration，放行该标签）。

			     之所以用 ${surefire.excludedGroups} 属性而非硬编码 "integration"：
			     硬编码的插件配置 Maven 不允许命令行 -D 覆盖（Day 28 核验时踩过——
			     -DexcludedGroups= 不生效），属性化后命令行才能真正覆盖。 -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<excludedGroups>${surefire.excludedGroups}</excludedGroups>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
